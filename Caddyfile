{$DOMAIN_NAME} {
    # Habilitar compresión automática para mejorar velocidad
    encode gzip zstd

    # Proxy para el backend (rutas que empiezan con /api/)
    handle /api/* {
        reverse_proxy backend:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Proxy para MinIO (imágenes públicas)
    handle /imagenes-sobracero/* {
        reverse_proxy minio:9000
    }

    # Proxy para el frontend (todo lo demás)
    handle /* {
        reverse_proxy frontend:80
    }
}